<?xml version="1.0"?>
<Container version="2">
  <Name>hifi-bridge</Name>
  <Repository>hifi-bridge:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/monochrome-music</Support>
  <Project>https://github.com/monochrome-music</Project>
  <Overview>Self-Hosted Hi-Fi Lossless Aggregator &amp; BitChord Source Module. Bridges public Hi-Fi lossless audio APIs with automatic failover, smart lookahead queue prefetching, and local SSD disk caching.</Overview>
  <Category>MediaApp:Music MediaServer:Music</Category>
  <WebUI>http://[IP]:[PORT:8742]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/walkxcode/dashboard-icons/main/svg/music.svg</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI &amp; API Port" Target="8742" Default="8742" Mode="tcp" Description="Port for BitChord module API and WebUI Dashboard" Type="Port" Display="always" Required="true" Mask="false">8742</Config>
  <Config Name="App Data Path" Target="/data" Default="/mnt/user/appdata/hifi-bridge/data" Mode="rw" Description="Location for database and local audio prefetch cache" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hifi-bridge/data</Config>
  <Config Name="Music Library Path" Target="/music" Default="/mnt/user/music" Mode="rw" Description="Location where archived FLAC tracks are saved (if archiving enabled)" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/music</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Unraid user ID (default 99 for nobody)" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Unraid group ID (default 100 for users)" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="Default Quality" Target="DEFAULT_QUALITY" Default="HI_RES_LOSSLESS" Mode="" Description="HI_RES_LOSSLESS, LOSSLESS, or HIGH" Type="Variable" Display="always" Required="false" Mask="false">HI_RES_LOSSLESS</Config>
  <Config Name="Max Cache Size (GB)" Target="MAX_CACHE_GB" Default="10" Mode="" Description="Maximum SSD cache storage for audio prefetch" Type="Variable" Display="always" Required="false" Mask="false">10</Config>
  <Config Name="Prefetch Lookahead" Target="PREFETCH_LOOKAHEAD" Default="2" Mode="" Description="Number of upcoming tracks to prefetch in background" Type="Variable" Display="always" Required="false" Mask="false">2</Config>
  <Config Name="Enable Prefetching" Target="PREFETCH_ENABLED" Default="true" Mode="" Description="Enable background queue prefetching (true/false)" Type="Variable" Display="always" Required="false" Mask="false">true</Config>
  <Config Name="Enable FLAC Archiving" Target="ENABLE_FLAC_ARCHIVE" Default="false" Mode="" Description="Set to true to permanently archive all played tracks to /music" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
</Container>
