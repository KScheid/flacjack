# hifi-bridge configuration
# Copy this file to .env and customize as needed.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8742
HOST=0.0.0.0

# ── Unraid User / Group (nobody:users) ────────────────────────────────────────
PUID=99
PGID=100

# ── Audio Quality ─────────────────────────────────────────────────────────────
# Options: HI_RES_LOSSLESS (24-bit/96kHz FLAC), LOSSLESS (16-bit/44.1kHz FLAC), HIGH (320kbps AAC)
DEFAULT_QUALITY=HI_RES_LOSSLESS

# ── Smart Lookahead Queue Prefetcher & Local SSD Disk Cache ───────────────────
# Caches audio tracks locally on disk for 0ms seek/instant playback and rate limit immunity
PREFETCH_ENABLED=true
PREFETCH_LOOKAHEAD=2                 # Prefetches next N tracks in current album/queue
AUDIO_CACHE_DIR=/data/audio_cache   # Local audio cache folder
MAX_CACHE_GB=10                     # Maximum disk cache size in GB before LRU pruning

# ── Playback Reliability ──────────────────────────────────────────────────────
# Serve all playback through FlacJack's proxy (recommended). Upstream CDN links
# expire and drop mid-song; the proxy re-resolves them and resumes from the exact
# byte, so tracks no longer stall and skip. false = hand clients the raw CDN URL.
PROXY_STREAMS=true
STREAM_RESUME_ATTEMPTS=5            # Re-open attempts per upstream outage before giving up
STREAM_STALL_TIMEOUT=20             # Seconds with no data from upstream before resuming

# ── Permanent FLAC Archiver / Library Saver ───────────────────────────────────
# Set to true to automatically save and tag all streamed tracks permanently to MUSIC_DIR
ENABLE_FLAC_ARCHIVE=false
MUSIC_DIR=/music

# ── Database & Metadata Caching ───────────────────────────────────────────────
DB_PATH=/data/hifi_bridge.db
CACHE_TTL_SECONDS=3600
CACHE_TTL_STREAM=3600
MAX_CACHE_ENTRIES=10000

# ── Mirror Management ─────────────────────────────────────────────────────────
# Comma-separated list of additional custom Hi-Fi API mirrors
# EXTRA_MIRRORS=https://custom-hifi.yourdomain.com

# Max concurrent requests to upstream mirrors (rate limiting protection)
MAX_CONCURRENT_UPSTREAM=20

# ── Security ──────────────────────────────────────────────────────────────────
# Required for remote access. URL-safe, 16+ characters: openssl rand -hex 24
# BitChord module URL: https://<your-host>/s/<SECRET_TOKEN>/bitchord-module.json
# SECRET_TOKEN=

# WebUI dashboard + admin APIs (/, /dashboard, /api/*, /mirrors*). Off by default
# because the dashboard shows the token. When on, it is LAN/Tailscale only.
WEBUI_ENABLED=false

# Extra hostnames trusted for LAN access (DNS-rebinding guard). IPs, localhost,
# single-label names and *.local/*.lan/*.home.arpa/*.internal/*.ts.net already work.
# ALLOWED_HOSTS=music.myhouse

# Browser origins allowed cross-origin access. BitChord does not need this.
# CORS_ORIGINS=

# Enable TLS certificate verification for upstream mirrors
# Default false to allow self-signed or internal reverse proxies
VERIFY_TLS=false
